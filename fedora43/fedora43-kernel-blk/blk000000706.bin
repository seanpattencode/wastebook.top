>>>>(4.L)	ubelong	0x100
# GRR: the line above only works if in ../../src/file.h FILE_BYTES_MAX is raised from 1 MiB above 0x6ab0f4 (HelveticaNeue.dfont)
>>>>>0	use	apple-rsr
# data fork variant with not zeroed system reserved field and no copy of header 
>>>>(4.L)	ubelong	0
>>>>>0	use	apple-rsr
