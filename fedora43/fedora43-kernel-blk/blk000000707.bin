#>>>&0	der	utc_time=x	\b, not-valid-before=%s
#>>>&0	der	utc_time=x	\b, not-valid-after=%s
>>&0	der	seq
>>>&0	der	set
>>>>&0	der	seq
>>>>>&0	der     obj_id3=550403
>>>>>&0	der     utf8_str=x      \b, Subject=%s

# PKCS#7 Signed Data (e.g. JAR Signature Block File)
