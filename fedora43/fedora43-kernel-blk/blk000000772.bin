  --interface'[Use network interface]':'<name>' \
  --disable-eprt'[Inhibit using EPRT or LPRT]' \
  --fail-early'[Fail on first transfer error]' \
  --ftp-pasv'[Send PASV/EPSV instead of PORT]' \
