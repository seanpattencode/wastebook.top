>>>&2		beshort		=0x0D0A
>>>>&0		beshort		!0x0D0A		\b, 3th line
>>>>>&-2	string		x		"%s"
# 2nd line with content
>>>&2		beshort		!0x0D0A		\b, 2nd line
>>>>&-2		string		x		"%s"

